<% content_for :title, "Talepler | DestekFlow" %>
<div class="dashboard-hero"><div><span class="hero-chip">OPERASYON MERKEZİ</span><h1>Destek talepleri</h1><div class="hero-subtitle">tek akışta yönetin.</div><p>SLA riskini görün, doğru kişiyi atayın ve kritik kararları insan denetiminde tutun.</p><div class="hero-actions"><%= link_to "+ Yeni talep oluştur", new_ticket_path, class: "button hero-button" %><%= link_to "Onay kuyruğunu aç →", approval_requests_path, class: "hero-link" %></div></div><div class="hero-visual" aria-hidden="true"><div class="pulse-card"><span>CANLI ÖNCELİK</span><strong><%= @tickets.count(&:first_response_overdue?) %> riskli talep</strong><small>AI destekli, insan kontrollü</small></div><div class="orb orb-one"></div><div class="orb orb-two"></div></div></div>
<div class="metric-grid">
  <div class="metric"><span class="metric-icon">01</span><div><span>Toplam görünüm</span><strong><%= @tickets.size %></strong></div></div>
  <div class="metric"><span class="metric-icon active">02</span><div><span>Aktif talepler</span><strong><%= @tickets.count(&:active?) %></strong></div></div>
  <div class="metric danger"><span class="metric-icon">!</span><div><span>SLA riski</span><strong><%= @tickets.count(&:first_response_overdue?) %></strong></div></div>
</div>
<div class="grid">
  <section>
    <div class="section-bar"><div><span class="eyebrow">TALEP AKIŞI</span><h2>Güncel iş kuyruğu</h2></div></div>
    <%= form_with url: tickets_path, method: :get, class: "filters" do %>
      <%= select_tag :status, options_for_select([["Tüm durumlar",""]] + Ticket::STATUSES.map { |s| [I18n.t("tickets.statuses.#{s}"),s] }, params[:status]), onchange: "this.form.requestSubmit()" %>
      <%= select_tag :priority, options_for_select([["Tüm öncelikler",""]] + Ticket::PRIORITIES.map { |p| [I18n.t("tickets.priorities.#{p}"),p] }, params[:priority]), onchange: "this.form.requestSubmit()" %>
    <% end %>
    <div class="ticket-list">
      <% @tickets.each do |ticket| %>
        <%= link_to ticket, class: "ticket-row" do %>
          <div><strong>#<%= ticket.id %> · <%= public_demo_text(ticket.subject) %></strong><div class="meta"><%= public_requester_label(ticket) %> · <%= ticket.assignee&.name || "Atanmamış" %></div><div class="badges"><span class="badge <%= ticket.priority %>"><%= t("tickets.priorities.#{ticket.priority}") %></span><span class="badge <%= ticket.status %>"><%= t("tickets.statuses.#{ticket.status}") %></span></div></div>
          <div class="sla-block"><span>SLA hedefi</span><strong><%= l ticket.sla_due_at, format: :short %></strong></div>
        <% end %>
      <% end %>
      <p class="lead"><%= "Henüz talep yok." if @tickets.empty? %></p>
    </div>
  </section>
  <aside class="card assistant-panel"><div class="assistant-mark">✦</div><span class="eyebrow">AÇIKLANABİLİR KURAL MOTORU</span><h2>Akıllı SLA Öncelik Asistanı</h2><p class="lead">Sıradaki işi kalan süre ve riskle açıklar.</p>
    <% @priorities.first(5).each_with_index do |result,index| %><div class="assistant-item"><strong><%= index + 1 %>. <%= link_to result.ticket.subject, result.ticket %></strong><p><%= result.reason %></p></div><% end %>
  </aside>
</div>
