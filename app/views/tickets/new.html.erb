<% content_for :title, "Yeni talep | DestekFlow" %>
<div class="page-head"><div><h1>Yeni destek talebi</h1><p class="lead">Sorununuzu ekibe iletin. SLA süresi önceliğe göre otomatik hesaplanır.</p></div></div>
<div class="card" style="max-width:760px">
  <% if @ticket.errors.any? %><div class="errors"><%= @ticket.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: @ticket do |f| %>
    <div class="demo-warning"><strong>Gizlilik koruması:</strong> Ad ve e-posta toplanmaz. Açıklamaya kişisel veya finansal bilgi yazmayın.</div>
    <div class="field"><%= f.label :subject, "Başlık" %><%= f.text_field :subject, required: true %></div>
    <div class="field"><%= f.label :description, "Açıklama" %><%= f.text_area :description, required: true %></div>
    <div class="inline"><div class="field"><%= f.label :category, "Kategori" %><%= f.select :category, Ticket::CATEGORIES.map { |c| [t("tickets.categories.#{c}"),c] } %></div><div class="field"><%= f.label :priority, "Öncelik" %><%= f.select :priority, Ticket::PRIORITIES.map { |p| [t("tickets.priorities.#{p}"),p] } %></div></div>
    <%= f.submit "Talebi oluştur", class: "button" %>
  <% end %>
</div>
