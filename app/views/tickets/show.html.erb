<% content_for :title, "##{@ticket.id} #{@ticket.subject} | DestekFlow" %>
<div class="page-head"><div><h1>#<%= @ticket.id %> · <%= @ticket.subject %></h1><div class="badges"><span class="badge <%= @ticket.priority %>"><%= t("tickets.priorities.#{@ticket.priority}") %></span><span class="badge <%= @ticket.status %>"><%= t("tickets.statuses.#{@ticket.status}") %></span></div></div><%= link_to "Tüm talepler", tickets_path, class: "button secondary" %></div>
<div class="detail"><div>
  <section class="card"><h2>Talep</h2><div class="meta"><%= @ticket.requester_name %> · <%= @ticket.requester_email %> · <%= t("tickets.categories.#{@ticket.category}") %></div><p class="description"><%= @ticket.description %></p></section>
  <section class="card" style="margin-top:20px"><h2>Yanıtlar</h2><% @ticket.replies.includes(:agent).each do |reply| %><div class="reply"><strong><%= reply.agent.name %></strong><small class="meta"> · <%= l reply.created_at, format: :short %></small><p><%= reply.body %></p></div><% end %>
    <% if @ticket.assignee && @ticket.status != "closed" %><%= form_with url: reply_ticket_path(@ticket), class: "field" do %><%= label_tag :body, "Temsilci yanıtı" %><%= text_area_tag :body, nil, required: true %><%= submit_tag "Yanıtı gönder", class: "button" %><% end %><% end %>
  </section>
  <section class="card" style="margin-top:20px"><h2>İşlem geçmişi</h2><ul class="timeline"><% @ticket.ticket_events.order(created_at: :desc).each do |event| %><li><strong><%= event.actor_name %></strong> · <%= event.details %><br><small><%= l event.created_at, format: :short %></small></li><% end %></ul></section>
</div><aside class="card actions"><h2>Yönetim</h2><div><strong>İlk yanıt SLA</strong><div class="meta"><%= l @ticket.sla_due_at, format: :long %><%= " · İHLAL" if @ticket.first_response_overdue? %></div></div>
  <% if @ticket.status != "closed" %><%= form_with url: assign_ticket_path(@ticket) do %><%= label_tag :agent_id, "Temsilci" %><%= select_tag :agent_id, options_from_collection_for_select(@agents, :id, :name, @ticket.assignee_id), required: true %><%= submit_tag "Ata", class: "button", style: "margin-top:8px;width:100%" %><% end %><% end %>
  <% @ticket.allowed_transitions.each do |status| %><%= button_to "Durumu #{t("tickets.statuses.#{status}")} yap", transition_ticket_path(@ticket, to: status), class: "secondary" %><% end %>
</aside></div>
